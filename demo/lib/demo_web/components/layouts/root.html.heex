<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Pure Admin Demo" suffix=" · PureAdmin">
      {assigns[:page_title]}
    </.live_title>
    <link rel="stylesheet" href={~p"/assets/css/pure-admin.css"} />
    <link rel="stylesheet" id="pa-theme-css" href="/themes/audi/css/audi.css" />
    <link rel="stylesheet" href={~p"/assets/css/demo.css"} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/core@1.6.9"></script>
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.6.13"></script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <.fouc_prevention_script />
    <script>
      // Apply theme from ?theme= query param or localStorage before paint
      (function() {
        var m = location.search.match(/[?&]theme=([^&]+)/);
        if (m) localStorage.setItem("theme", decodeURIComponent(m[1]));
        var t = localStorage.getItem("theme");
        if (t) {
          var link = document.getElementById("pa-theme-css");
          if (link) link.href = "/themes/" + t + "/css/" + t + ".css";
        }
      })();
    </script>
    {@inner_content}
  </body>
</html>
