<.layout>
  <.navbar>
    <:start>
      <.navbar_burger />
      <.navbar_brand />
      <.navbar_nav>
        <.navbar_nav_item href="/">Dashboard</.navbar_nav_item>
        <.navbar_nav_item href="/components/buttons" has_dropdown>
          Components
          <:dropdown>
            <.navbar_dropdown>
              <.navbar_nav_item href="/components/buttons">Buttons</.navbar_nav_item>
              <.navbar_nav_item href="/components/cards">Cards</.navbar_nav_item>
              <.navbar_nav_item href="/components/tabs">Tabs</.navbar_nav_item>
              <.navbar_nav_item has_dropdown>
                More ›
                <:dropdown>
                  <.navbar_dropdown is_level2>
                    <.navbar_nav_item href="/components/badges">Badges</.navbar_nav_item>
                    <.navbar_nav_item href="/components/modals">Modals</.navbar_nav_item>
                    <.navbar_nav_item href="/components/modal-dialogs">Modal Dialogs</.navbar_nav_item>
                    <.navbar_nav_item href="/components/popconfirm">Popconfirm</.navbar_nav_item>
                    <.navbar_nav_item href="/components/command-palette">Command Palette</.navbar_nav_item>
                    <.navbar_nav_item href="/components/data-display">Data Display</.navbar_nav_item>
                    <.navbar_nav_item href="/components/data-display-2">Data Display 2</.navbar_nav_item>
                    <.navbar_nav_item href="/components/data-visualization">Data Visualization</.navbar_nav_item>
                    <.navbar_nav_item href="/components/detail-panel">Detail Panel</.navbar_nav_item>
                    <.navbar_nav_item href="/components/loaders">Loaders</.navbar_nav_item>
                    <.navbar_nav_item href="/components/lists">Lists</.navbar_nav_item>
                    <.navbar_nav_item href="/components/code">Code</.navbar_nav_item>
                    <.navbar_nav_item href="/components/callouts">Callouts</.navbar_nav_item>
                    <.navbar_nav_item href="/components/typography">Typography</.navbar_nav_item>
                    <.navbar_nav_item href="/components/stats">Stats</.navbar_nav_item>
                  </.navbar_dropdown>
                </:dropdown>
              </.navbar_nav_item>
            </.navbar_dropdown>
          </:dropdown>
        </.navbar_nav_item>
        <.navbar_nav_item href="/forms">Forms</.navbar_nav_item>
      </.navbar_nav>
    </:start>
    <:center>
      <.navbar_title>
        <h2>{assigns[:page_title] || "Dashboard"}</h2>
      </.navbar_title>
    </:center>
    <:end_>
      <.navbar_nav position="end">
        <.navbar_nav_item href="/components/alerts">Alerts</.navbar_nav_item>
        <.navbar_nav_item href="/tables/standard">Tables</.navbar_nav_item>
      </.navbar_nav>
      <.notifications count={3}>
        <.notification_item variant="primary" icon="fa-solid fa-file-pen" is_unread>
          <:title>New task assigned</:title>
          <:text>Review the Q4 report by end of week</:text>
          <:time>2 minutes ago</:time>
        </.notification_item>
        <.notification_item variant="success" icon="fa-solid fa-check" is_unread>
          <:title>Build completed</:title>
          <:text>Production deployment finished successfully</:text>
          <:time>15 minutes ago</:time>
        </.notification_item>
        <.notification_item variant="warning" icon="fa-solid fa-triangle-exclamation">
          <:title>Server maintenance</:title>
          <:text>Scheduled downtime tonight at 11 PM</:text>
          <:time>1 hour ago</:time>
        </.notification_item>
        <:footer_>
          <a href="#">View all notifications</a>
        </:footer_>
      </.notifications>
      <.navbar_profile_btn name="John Doe" phx-click={toggle_profile_panel()} />
    </:end_>
  </.navbar>

  <.layout_inner>
    <.sidebar>
      <.sidebar_item
        label="Getting Started"
        icon="fa-solid fa-rocket"
        href="/getting-started"
        is_active={@current_path == "/getting-started"}
      />

      <.sidebar_item
        label="Dashboard"
        icon="fa-solid fa-gauge"
        href="/"
        is_active={@current_path == "/"}
      />

      <.sidebar_item
        label="Forms"
        icon="fa-solid fa-pen-to-square"
        href="/forms"
        is_active={@current_path == "/forms"}
      />

      <.sidebar_submenu id="phoenix" label="Phoenix / LiveView" icon="fa-solid fa-fire" is_open={String.starts_with?(@current_path, "/phoenix")}>
        <.sidebar_item label="CoreComponents Migration" href="/phoenix/core-components" is_active={@current_path == "/phoenix/core-components"} />
        <.sidebar_item label="Flash Messages" href="/phoenix/flash" is_active={@current_path == "/phoenix/flash"} />
        <.sidebar_item label="Form Demo" href="/phoenix/form-demo" is_active={@current_path == "/phoenix/form-demo"} />
      </.sidebar_submenu>

      <.sidebar_submenu id="components" label="Components" icon="fa-solid fa-puzzle-piece" is_open={String.starts_with?(@current_path, "/components")}>
        <.sidebar_item label="Buttons" href="/components/buttons" is_active={@current_path == "/components/buttons"} />
        <.sidebar_item label="Inputs" href="/components/inputs" is_active={@current_path == "/components/inputs"} />
        <.sidebar_item label="Validations" href="/components/validations" is_active={@current_path == "/components/validations"} />
        <.sidebar_item label="Cards" href="/components/cards" is_active={@current_path == "/components/cards"} />
        <.sidebar_item label="Grid System" href="/components/grid" is_active={@current_path == "/components/grid"} />
        <.sidebar_item label="Tabs" href="/components/tabs" is_active={@current_path == "/components/tabs"} />
        <.sidebar_item label="Badges" href="/components/badges" is_active={@current_path == "/components/badges"} />
        <.sidebar_item label="Lists" href="/components/lists" is_active={@current_path == "/components/lists"} />
        <.sidebar_item label="Checkbox Lists" href="/components/checkbox-lists" is_active={@current_path == "/components/checkbox-lists"} />
        <.sidebar_item label="Code" href="/components/code" is_active={@current_path == "/components/code"} />
        <.sidebar_item label="Alerts" href="/components/alerts" is_active={@current_path == "/components/alerts"} />
        <.sidebar_item label="Callouts" href="/components/callouts" is_active={@current_path == "/components/callouts"} />
        <.sidebar_item label="Toasts" href="/components/toasts" is_active={@current_path == "/components/toasts"} />
        <.sidebar_item label="Loaders" href="/components/loaders" is_active={@current_path == "/components/loaders"} />
        <.sidebar_item label="Pagers" href="/components/pagers" is_active={@current_path == "/components/pagers"} />
        <.sidebar_item label="Tooltips" href="/components/tooltips" is_active={@current_path == "/components/tooltips"} />
        <.sidebar_item label="Modals" href="/components/modals" is_active={@current_path == "/components/modals"} />
        <.sidebar_item label="Modal Dialogs" href="/components/modal-dialogs" is_active={@current_path == "/components/modal-dialogs"} />
        <.sidebar_item label="Popconfirm" href="/components/popconfirm" is_active={@current_path == "/components/popconfirm"} />
        <.sidebar_item label="Command Palette" href="/components/command-palette" is_active={@current_path == "/components/command-palette"} />
        <.sidebar_item label="Data Display" href="/components/data-display" is_active={@current_path == "/components/data-display"} />
        <.sidebar_item label="Data Display 2" href="/components/data-display-2" is_active={@current_path == "/components/data-display-2"} />
        <.sidebar_item label="Data Visualization" href="/components/data-visualization" is_active={@current_path == "/components/data-visualization"} />
        <.sidebar_item label="Detail Panel" href="/components/detail-panel" is_active={@current_path == "/components/detail-panel"} />
        <.sidebar_item label="Notifications" href="/components/notifications" is_active={@current_path == "/components/notifications"} />
        <.sidebar_item label="Stats" href="/components/stats" is_active={@current_path == "/components/stats"} />
        <.sidebar_item label="Sizing" href="/components/sizing" is_active={@current_path == "/components/sizing"} />
        <.sidebar_item label="Typography" href="/components/typography" is_active={@current_path == "/components/typography"} />
      </.sidebar_submenu>

      <.sidebar_submenu id="design" label="Design" icon="fa-solid fa-palette" is_open={String.starts_with?(@current_path, "/design")}>
        <.sidebar_item label="Colors" href="/design/colors" is_active={@current_path == "/design/colors"} />
        <.sidebar_item label="Theme Variables" href="/design/theme-variables" is_active={@current_path == "/design/theme-variables"} />
        <.sidebar_item label="CSS Helpers" href="/design/helpers" is_active={@current_path == "/design/helpers"} />
        <.sidebar_item label="Layouts" href="/design/layouts" is_active={@current_path == "/design/layouts"} />
      </.sidebar_submenu>

      <.sidebar_submenu id="tables" label="Tables" icon="fa-solid fa-table" is_open={String.starts_with?(@current_path, "/tables")}>
        <.sidebar_item label="Standard Tables" href="/tables/standard" is_active={@current_path == "/tables/standard"} />
        <.sidebar_item label="Table Sizing" href="/tables/sizing" is_active={@current_path == "/tables/sizing"} />
        <.sidebar_item label="Responsive" href="/tables/responsive" is_active={@current_path == "/tables/responsive"} />
        <.sidebar_item label="Filters" href="/tables/filters" is_active={@current_path == "/tables/filters"} />
        <.sidebar_item label="Multi-Select" href="/tables/multi-select" is_active={@current_path == "/tables/multi-select"} />
        <.sidebar_item label="Comparison" href="/tables/comparison" is_active={@current_path == "/tables/comparison"} />
      </.sidebar_submenu>

      <.sidebar_submenu id="timeline" label="Timeline" icon="fa-solid fa-clock-rotate-left" is_open={String.starts_with?(@current_path, "/timeline")}>
        <.sidebar_item label="Simple" href="/timeline/simple" is_active={@current_path == "/timeline/simple"} />
        <.sidebar_item label="Block" href="/timeline/block" is_active={@current_path == "/timeline/block"} />
        <.sidebar_item label="Feed" href="/timeline/feed" is_active={@current_path == "/timeline/feed"} />
        <.sidebar_item label="Advanced" href="/timeline/advanced" is_active={@current_path == "/timeline/advanced"} />
      </.sidebar_submenu>

      <.sidebar_submenu id="virtual-scroll" label="Virtual Scroll" icon="fa-solid fa-arrows-up-down" is_open={String.starts_with?(@current_path, "/virtual-scroll")}>
        <.sidebar_item label="Demo" href="/virtual-scroll/demo" is_active={@current_path == "/virtual-scroll/demo"} />
      </.sidebar_submenu>
    </.sidebar>

    <.layout_content>
      <.main>
        <.flash_group flash={@flash} />
        {@inner_content}
      </.main>

      <.footer />
    </.layout_content>
  </.layout_inner>
</.layout>

<.profile_panel id="profile-panel" name="John Doe" email="john.doe@company.com" role="Administrator">
  <:tabs>
    <div class="pa-tabs pa-tabs--full">
      <button class="pa-tabs__item pa-tabs__item--active" data-profile-tab="profile">
        <i class="fa-solid fa-user"></i>
        <span class="pa-profile-panel__tab-text">Profile</span>
      </button>
      <button class="pa-tabs__item" data-profile-tab="favorites">
        <i class="fa-solid fa-star"></i>
        <span class="pa-profile-panel__tab-text">Favorites</span>
      </button>
    </div>
  </:tabs>

  <div class="pa-tabs__panel pa-tabs__panel--active" data-profile-panel="profile">
    <nav class="pa-profile-panel__nav">
      <ul>
        <.profile_nav_item href="#" icon="fa-solid fa-user">Profile Settings</.profile_nav_item>
        <.profile_nav_item href="#" icon="fa-solid fa-lock">Security</.profile_nav_item>
        <.profile_nav_item href="#" icon="fa-solid fa-bell">Notifications</.profile_nav_item>
        <.profile_nav_item href="#" icon="fa-solid fa-gear">Preferences</.profile_nav_item>
        <.profile_nav_item href="#" icon="fa-solid fa-circle-question">
          Help & Support
        </.profile_nav_item>
      </ul>
    </nav>
  </div>

  <div class="pa-tabs__panel" data-profile-panel="favorites">
    <div class="pa-profile-panel__favorites">
      <ul>
        <li>
          <div class="pa-profile-panel__favorite-item" data-href="/">
            <span class="pa-profile-panel__favorite-icon"><i class="fa-solid fa-gauge"></i></span>
            <span class="pa-profile-panel__favorite-label">Dashboard</span>
            <button class="pa-profile-panel__favorite-remove" title="Remove from favorites">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </li>
        <li>
          <div class="pa-profile-panel__favorite-item" data-href="/forms">
            <span class="pa-profile-panel__favorite-icon"><i class="fa-solid fa-pen-to-square"></i></span>
            <span class="pa-profile-panel__favorite-label">Forms</span>
            <button class="pa-profile-panel__favorite-remove" title="Remove from favorites">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <:footer_>
    <button class="pa-btn pa-btn--secondary pa-btn--block">
      <i class="fa-solid fa-right-left"></i> Switch Account
    </button>
    <button class="pa-btn pa-btn--danger pa-btn--block">
      <i class="fa-solid fa-right-from-bracket"></i> Sign Out
    </button>
  </:footer_>
</.profile_panel>

<.settings_panel default_theme="audi" />

<.toast_container id="toasts" position="top-end" is_hook />
