<.layout>
  <.navbar>
    <:start>
      <.navbar_burger />
      <.navbar_brand>
        <h1>Pure Admin</h1>
      </.navbar_brand>
      <.navbar_nav>
        <.navbar_nav_item href="/">Dashboard</.navbar_nav_item>
        <.navbar_nav_item href="/buttons" has_dropdown>
          Components
          <:dropdown>
            <.navbar_dropdown>
              <.navbar_nav_item href="/buttons">Buttons</.navbar_nav_item>
              <.navbar_nav_item href="/cards">Cards</.navbar_nav_item>
              <.navbar_nav_item href="/tabs">Tabs</.navbar_nav_item>
              <.navbar_nav_item has_dropdown>
                More ›
                <:dropdown>
                  <.navbar_dropdown is_level2>
                    <.navbar_nav_item href="/badges">Badges</.navbar_nav_item>
                    <.navbar_nav_item href="/modals">Modals</.navbar_nav_item>
                    <.navbar_nav_item href="/loaders">Loaders</.navbar_nav_item>
                    <.navbar_nav_item href="/lists">Lists</.navbar_nav_item>
                    <.navbar_nav_item href="/code">Code</.navbar_nav_item>
                    <.navbar_nav_item href="/callouts">Callouts</.navbar_nav_item>
                    <.navbar_nav_item href="/typography">Typography</.navbar_nav_item>
                    <.navbar_nav_item href="/stats">Stats</.navbar_nav_item>
                  </.navbar_dropdown>
                </:dropdown>
              </.navbar_nav_item>
            </.navbar_dropdown>
          </:dropdown>
        </.navbar_nav_item>
        <.navbar_nav_item href="/forms">Forms</.navbar_nav_item>
      </.navbar_nav>
    </:start>
    <:center>
      <.navbar_title>
        <h2>{assigns[:page_title] || "Dashboard"}</h2>
      </.navbar_title>
    </:center>
    <:end_>
      <.navbar_nav position="end">
        <.navbar_nav_item href="/alerts">Alerts</.navbar_nav_item>
        <.navbar_nav_item href="/tables">Tables</.navbar_nav_item>
      </.navbar_nav>
      <.notifications count={3}>
        <.notification_item variant="primary" icon="fa-solid fa-file-pen" is_unread>
          <:title>New task assigned</:title>
          <:text>Review the Q4 report by end of week</:text>
          <:time>2 minutes ago</:time>
        </.notification_item>
        <.notification_item variant="success" icon="fa-solid fa-check" is_unread>
          <:title>Build completed</:title>
          <:text>Production deployment finished successfully</:text>
          <:time>15 minutes ago</:time>
        </.notification_item>
        <.notification_item variant="warning" icon="fa-solid fa-triangle-exclamation">
          <:title>Server maintenance</:title>
          <:text>Scheduled downtime tonight at 11 PM</:text>
          <:time>1 hour ago</:time>
        </.notification_item>
        <:footer_>
          <a href="#">View all notifications</a>
        </:footer_>
      </.notifications>
      <.navbar_profile_btn name="John Doe" phx-click={toggle_profile_panel()} />
    </:end_>
  </.navbar>

  <.layout_inner>
    <.sidebar id="demo-sidebar">
      <.sidebar_item
        label="Dashboard"
        icon="fa-solid fa-gauge"
        href="/"
        is_active={@current_path == "/"}
      />

      <.sidebar_submenu label="Components" icon="fa-solid fa-puzzle-piece" is_open>
        <.sidebar_item label="Buttons" href="/buttons" is_active={@current_path == "/buttons"} />
        <.sidebar_item label="Badges" href="/badges" is_active={@current_path == "/badges"} />
        <.sidebar_item label="Alerts" href="/alerts" is_active={@current_path == "/alerts"} />
        <.sidebar_item label="Cards" href="/cards" is_active={@current_path == "/cards"} />
        <.sidebar_item label="Modals" href="/modals" is_active={@current_path == "/modals"} />
        <.sidebar_item label="Tabs" href="/tabs" is_active={@current_path == "/tabs"} />
        <.sidebar_item label="Loaders" href="/loaders" is_active={@current_path == "/loaders"} />
        <.sidebar_item label="Lists" href="/lists" is_active={@current_path == "/lists"} />
        <.sidebar_item label="Code" href="/code" is_active={@current_path == "/code"} />
        <.sidebar_item label="Callouts" href="/callouts" is_active={@current_path == "/callouts"} />
        <.sidebar_item
          label="Typography"
          href="/typography"
          is_active={@current_path == "/typography"}
        />
        <.sidebar_item label="Stats" href="/stats" is_active={@current_path == "/stats"} />
      </.sidebar_submenu>

      <.sidebar_submenu label="Layout" icon="fa-solid fa-table-columns">
        <.sidebar_item label="Grid System" href="/grid" is_active={@current_path == "/grid"} />
      </.sidebar_submenu>

      <.sidebar_submenu label="Data" icon="fa-solid fa-database">
        <.sidebar_item label="Tables" href="/tables" is_active={@current_path == "/tables"} />
        <.sidebar_item label="Timeline" href="/timeline" is_active={@current_path == "/timeline"} />
      </.sidebar_submenu>

      <.sidebar_item
        label="Forms"
        icon="fa-solid fa-pen-to-square"
        href="/forms"
        is_active={@current_path == "/forms"}
      />
    </.sidebar>

    <.layout_content>
      <.main>
        <Layouts.flash_group flash={@flash} />
        {@inner_content}
      </.main>

      <.footer>
        <:start>
          <span>Pure Admin LiveView Demo &copy; 2024 KeenMate</span>
        </:start>
        <:end_>
          <span>v0.1.0</span>
        </:end_>
      </.footer>
    </.layout_content>
  </.layout_inner>
</.layout>

<.profile_panel id="profile-panel" name="John Doe" email="john.doe@company.com" role="Administrator">
  <:nav>
    <.profile_nav_item href="#" icon="fa-solid fa-user">Profile Settings</.profile_nav_item>
    <.profile_nav_item href="#" icon="fa-solid fa-lock">Security</.profile_nav_item>
    <.profile_nav_item href="#" icon="fa-solid fa-bell">Notifications</.profile_nav_item>
    <.profile_nav_item href="#" icon="fa-solid fa-gear">Preferences</.profile_nav_item>
  </:nav>
  <:footer_>
    <button class="pa-btn pa-btn--secondary pa-btn--block">Switch Account</button>
    <button class="pa-btn pa-btn--danger pa-btn--block">Sign Out</button>
  </:footer_>
</.profile_panel>

<.settings_panel />
